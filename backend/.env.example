# ====================================
# Daily Hikmah - Environment Variables
# ====================================

# VAPID Keys (Required for Push Notifications)
# Generate these keys by running the backend once locally
# or use: go run generate_vapid_keys.go

VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# Server Port (Optional - Render sets this automatically)
# For local development, use 8080
PORT=8080

# Gemini (backend only; required to generate new Hikmah)
GEMINI_API_KEY=
# 2.5 Flash requires prior account access; alternatively use an available
# free-tier model from your AI Studio project, e.g. gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash
HIKMAH_TIMEZONE=Asia/Bahrain
# Ignored persistent daily cache. Use durable storage in production.
HIKMAH_CACHE_FILE=.cache/daily-hikmah.json

# Optional testing override; leave unset for calendar-day caching.
# Applies to all users of this backend. More frequent AI calls use more quota.
# HIKMAH_REFRESH_INTERVAL=1m
